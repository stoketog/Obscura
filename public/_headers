# Cloudflare (Pages or Workers static assets) reads this file; other hosts ignore it.

# Files whose names change whenever their content does: cache for a year.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
/answers/*
  Cache-Control: public, max-age=31536000, immutable

# Photographs are named after their subject, not their content, so a replaced photo must still get through.
/daily/*
  Cache-Control: public, max-age=604800

# Icons and the app manifest change rarely.
/icons/*
  Cache-Control: public, max-age=604800
/manifest.webmanifest
  Cache-Control: public, max-age=86400

# The service worker and the page itself must always be checked, so a new day and a new release arrive at once.
/sw.js
  Cache-Control: no-cache
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache

# Basic hardening for every response.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
